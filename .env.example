# Server Configuration
PORT=3000

# MongoDB Atlas Connection String (database: hostelDB)
MONGODB_URI=your_mongodb_connection_string

# JWT Signing Secret (use a long random string in production)
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS (e.g., VS Code Live Server)
CLIENT_URL=http://127.0.0.1:5500

# Initial Admin Provisioning (used only by protected seed script: backend/utils/seedAdmin.js)
ADMIN_SEED_NAME=Hostel Chief Warden
ADMIN_SEED_EMAIL=warden.admin@university.edu
ADMIN_SEED_PASSWORD=change_this_secure_password
ADMIN_SEED_KEY=change_this_seed_key

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
